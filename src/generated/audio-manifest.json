    "generatedAt": "2026-11-06T14:36:06.199Z"
  },
  {
    "lineId": "kyc.deflect_identity",
    "locale": "hi",
    "text": "मैंने बताया ना, मैं बैंक की केवाईसी टीम से हूँ। मेरी एम्प्लॉई आईडी सिस्टम में है, आप चिंता मत कीजिए।",
    "model": "timbre-v3.0",
    "voice": "Avinash",
